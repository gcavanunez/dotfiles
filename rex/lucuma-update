#!/usr/bin/env bash
set -euo pipefail

if [[ $# == 1 && "$1" == --help ]]; then
    echo 'Usage: lucuma-update'
    echo 'From a Mac terminal: update Lucuma over SSH, then ask before restarting Rex.'
    exit 0
fi
if [[ $# != 0 || ! -t 0 ]]; then
    echo 'Run lucuma-update interactively from a Mac-hosted terminal.' >&2
    exit 2
fi
if [[ "$(uname -s)" != Darwin ]]; then
    echo 'Run this on Air or Pro, not inside a Lucuma-hosted Rex pane.' >&2
    exit 1
fi

# A real SSH terminal handles sudo and survives stopping the remote Rex server.
exec ssh -t -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=8 \
    lucuma@100.101.46.13 '
set -eu
unset REX_SERVER REX_CLIENT REX_SESSION REX_BLOCK
omarchy update

printf "\nUpdate succeeded. Restarting Rex ends programs in all its sessions.\n"
printf "Type restart to continue, or press Enter to leave Rex running: "
read -r answer || exit 0
if [ "$answer" != restart ]; then
    echo "Update complete; Rex left running."
    exit 0
fi

/usr/bin/rex --autostart=false server stop
/usr/bin/rex server start --tailscale --tailscale-hostname arch-lucuma-rex
/usr/bin/rex server status
'
