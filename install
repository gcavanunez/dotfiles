#!/usr/bin/env bash
set -euo pipefail

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
mkdir -p "$HOME/.config"

# nvim
rm -rf "$HOME/.config/nvim"
ln -s "$DOTFILES/nvim" "$HOME/.config/nvim"

# Alacritty
rm -rf "$HOME/.config/alacritty"
ln -s "$DOTFILES/alacritty" "$HOME/.config/alacritty"

# Kitty
rm -rf "$HOME/.config/kitty"
ln -s "$DOTFILES/kitty" "$HOME/.config/kitty"

# Tmux
mkdir -p "$HOME/.config/tmux"
ln -sf "$DOTFILES/tmux/tmux.conf" "$HOME/.config/tmux/tmux.conf"
# Retire this repo's legacy config link so tmux consistently uses the XDG path.
if [[ -L $HOME/.tmux.conf && $(readlink -f "$HOME/.tmux.conf") == "$DOTFILES/tmux/tmux.conf" ]]; then
    rm "$HOME/.tmux.conf"
fi
mkdir -p "$HOME/.local/bin"
ln -sf "$DOTFILES/tmux/tmux-host-style" "$HOME/.local/bin/tmux-host-style"
ln -sf "$DOTFILES/tmux/tmux-host-color" "$HOME/.local/bin/tmux-host-color"

# tmux-sessionizer
ln -sf "$DOTFILES/tmux/tmux-sessionizer" "$HOME/.local/bin/tmux-sessionizer"
ln -sf "$DOTFILES/herdr/herdr-sessionizer" "$HOME/.local/bin/herdr-sessionizer"
mkdir -p "$HOME/.config/tmux-sessionizer"
if [[ ! -f $HOME/.config/tmux-sessionizer/tmux-sessionizer.conf ]]; then
    cp "$DOTFILES/tmux/tmux-sessionizer.conf" "$HOME/.config/tmux-sessionizer/tmux-sessionizer.conf"
    echo "Created default tmux-sessionizer config — edit ~/.config/tmux-sessionizer/tmux-sessionizer.conf to customize"
fi

if [[ "$(uname -s)" == "Linux" ]]; then
    # Network diagnostics
    ln -sf "$DOTFILES/scripts/network-speedtest" "$HOME/.local/bin/network-speedtest"

    # Lutris must use the system Python that owns its packaged modules.
    if [[ -x /usr/bin/lutris ]]; then
        mkdir -p "$HOME/.local/share/applications"
        ln -sf "$DOTFILES/scripts/lutris" "$HOME/.local/bin/lutris"
        ln -sf "$DOTFILES/omarchy/net.lutris.Lutris.desktop" \
            "$HOME/.local/share/applications/net.lutris.Lutris.desktop"
    fi
fi

# https://gist.github.com/dhh/159b129f511f76db3ae8adb463f70d05
# zellij
rm -rf "$HOME/.config/zellij"
ln -sf "$DOTFILES/zellij" "$HOME/.config/zellij"

# Herdr
rm -rf "$HOME/.config/herdr"
ln -s "$DOTFILES/herdr" "$HOME/.config/herdr"
if command -v herdr >/dev/null 2>&1; then
    command -v jq >/dev/null 2>&1 || {
        echo "Herdr tmux navigation requires jq" >&2
        exit 1
    }
    herdr plugin link "$DOTFILES/herdr/plugins/tmux-navigation" --enabled >/dev/null
fi

# Rex (only configuration is linked; server and Tailscale state stay machine-local)
rex_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/rex"
mkdir -p "$rex_config_dir"
rex_config="$rex_config_dir/init.lua"
if [[ -e "$rex_config" || -L "$rex_config" ]]; then
    if [[ ! -L "$rex_config" || "$(readlink "$rex_config")" != "$DOTFILES/rex/init.lua" ]]; then
        echo "Rex config already exists — merge $rex_config before linking" >&2
        exit 1
    fi
else
    ln -s "$DOTFILES/rex/init.lua" "$rex_config"
fi
# Rex resolves require() beside the configured file, including when it is a symlink.
rex_vendor="$rex_config_dir/vendor"
if [[ -e "$rex_vendor" || -L "$rex_vendor" ]]; then
    if [[ ! -L "$rex_vendor" || "$(readlink "$rex_vendor")" != "$DOTFILES/rex/vendor" ]]; then
        echo "Rex vendor directory already exists — merge $rex_vendor before linking" >&2
        exit 1
    fi
else
    ln -s "$DOTFILES/rex/vendor" "$rex_vendor"
fi
rex_sessionizer="$HOME/.local/bin/rex-sessionizer"
if [[ -e "$rex_sessionizer" || -L "$rex_sessionizer" ]]; then
    if [[ ! -L "$rex_sessionizer" || "$(readlink "$rex_sessionizer")" != "$DOTFILES/rex/rex-sessionizer" ]]; then
        echo "Rex sessionizer already exists — merge $rex_sessionizer before linking" >&2
        exit 1
    fi
else
    ln -s "$DOTFILES/rex/rex-sessionizer" "$rex_sessionizer"
fi
for relative in rex-copy-mode copy-mode.lua; do
    if [[ "$relative" == rex-copy-mode ]]; then
        target="$HOME/.local/bin/$relative"
    else
        target="$rex_config_dir/$relative"
    fi
    source="$DOTFILES/rex/$relative"
    if [[ -e "$target" || -L "$target" ]]; then
        if [[ ! -L "$target" || "$(readlink "$target")" != "$source" ]]; then
            echo "Rex copy mode already exists — merge $target before linking" >&2
            exit 1
        fi
    else
        ln -s "$source" "$target"
    fi
done

lucuma_update="$HOME/.local/bin/lucuma-update"
if [[ -e "$lucuma_update" || -L "$lucuma_update" ]]; then
    if [[ ! -L "$lucuma_update" || "$(readlink "$lucuma_update")" != "$DOTFILES/rex/lucuma-update" ]]; then
        echo "Lucuma update script already exists — merge $lucuma_update before linking" >&2
        exit 1
    fi
else
    ln -s "$DOTFILES/rex/lucuma-update" "$lucuma_update"
fi
# Retire only this repo's old Python helper link, not an unrelated command.
rex_lucuma_restart="$HOME/.local/bin/rex-lucuma-restart"
if [[ -L "$rex_lucuma_restart" && "$(readlink "$rex_lucuma_restart")" == "$DOTFILES/rex/rex-lucuma-restart" ]]; then
    rm "$rex_lucuma_restart"
fi

# Rex themes are available for per-app import, not applied automatically.
rex_themes="$rex_config_dir/themes"
if [[ -e "$rex_themes" || -L "$rex_themes" ]]; then
    if [[ ! -L "$rex_themes" || "$(readlink "$rex_themes")" != "$DOTFILES/rex/themes" ]]; then
        echo "Rex themes already exist — merge $rex_themes before linking" >&2
        exit 1
    fi
else
    ln -s "$DOTFILES/rex/themes" "$rex_themes"
fi

# Pi (settings, credentials, sessions, trust, and package state remain machine-local)
pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
case "$pi_agent_dir" in
    "~") pi_agent_dir="$HOME" ;;
    "~/"*) pi_agent_dir="$HOME/${pi_agent_dir#\~/}" ;;
esac
mkdir -p "$pi_agent_dir"

pi_prompts="$pi_agent_dir/prompts"
if [[ -e "$pi_prompts" && ! -L "$pi_prompts" ]]; then
    echo "Pi prompts already exist — merge $pi_prompts before linking" >&2
    exit 1
else
    ln -sfn "$DOTFILES/pi/prompts" "$pi_prompts"
fi

pi_extensions="$pi_agent_dir/extensions"
mkdir -p "$pi_extensions"
for source in "$DOTFILES/pi/extensions/goal.ts" "$DOTFILES/pi/extensions/answer.ts"; do
    target="$pi_extensions/$(basename "$source")"
    if [[ -e "$target" || -L "$target" ]]; then
        if [[ ! -L "$target" || "$(readlink "$target")" != "$source" ]]; then
            echo "Pi extension already exists — merge $target before linking" >&2
            exit 1
        fi
    else
        ln -s "$source" "$target"
    fi
done

# Herdr agent integrations (Herdr owns the generated files; restart the agent after upgrades)
if command -v herdr >/dev/null 2>&1; then
    herdr integration install pi >/dev/null
    # Herdr's OpenCode integration supports OpenCode V2 from 0.9.1.
    herdr_version=$(herdr --version | awk '{ print $2 }')
    if [[ $(printf '%s\n' 0.9.1 "$herdr_version" | sort -V | head -1) == 0.9.1 ]]; then
        herdr integration install opencode >/dev/null
    else
        echo "Herdr $herdr_version predates OpenCode V2 support; upgrade Herdr to 0.9.1+ and rerun install" >&2
    fi
fi

# wezterm
rm -rf "$HOME/.config/wezterm"
ln -s "$DOTFILES/wezterm" "$HOME/.config/wezterm"

# lazygit
rm -rf "$HOME/.config/lazygit"
ln -s "$DOTFILES/lazygit" "$HOME/.config/lazygit"

# ghostty
rm -rf "$HOME/.config/ghostty"
ln -s "$DOTFILES/ghostty" "$HOME/.config/ghostty"

# Karabiner
if [[ "$(uname -s)" == "Darwin" ]]; then
    mkdir -p "$HOME/.config/karabiner"
    ln -sf "$DOTFILES/karabiner/karabiner.json" "$HOME/.config/karabiner/karabiner.json"
fi

# Starship
ln -sf "$DOTFILES/starship/starship.toml" "$HOME/.config/starship.toml"

# Git
ln -sf "$DOTFILES/git/gitconfig-delta" "$HOME/.gitconfig-delta"
mkdir -p "$HOME/.config/git"
ln -sf "$DOTFILES/git/ignore" "$HOME/.config/git/ignore"

# Zsh functions and aliases (symlinked — .zshrc itself is machine-specific)
mkdir -p "$HOME/.config/zsh"
ln -sf "$DOTFILES/zsh/functions.zsh" "$HOME/.config/zsh/functions.zsh"
ln -sf "$DOTFILES/zsh/aliases.zsh" "$HOME/.config/zsh/aliases.zsh"

# Bash functions and aliases (shared files — .bashrc itself is machine-specific)
mkdir -p "$HOME/.config/bash"
ln -sf "$DOTFILES/bash/pre.bash" "$HOME/.config/bash/pre.bash"
ln -sf "$DOTFILES/bash/init.bash" "$HOME/.config/bash/init.bash"
ln -sf "$DOTFILES/zsh/functions.zsh" "$HOME/.config/bash/functions.bash"
ln -sf "$DOTFILES/zsh/aliases.zsh" "$HOME/.config/bash/aliases.bash"
