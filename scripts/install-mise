#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) == Linux && -r /etc/os-release ]]; then
  source /etc/os-release
  if [[ ${ID:-} == omarchy ]]; then
    if [[ ! -x /usr/bin/mise ]] || ! pacman -Qq mise-bin &>/dev/null; then
      echo "Omarchy manages mise through mise-bin. Install it with omarchy update." >&2
      exit 1
    fi
    echo "Using Omarchy-managed $(/usr/bin/mise --version) at /usr/bin/mise"
    exit 0
  fi
fi

INSTALL_PATH="${MISE_INSTALL_PATH:-$HOME/.local/bin/mise}"
INSTALLER=""

cleanup() {
  [[ -z "$INSTALLER" ]] || rm -f "$INSTALLER"
}

trap cleanup EXIT

INSTALLER=$(mktemp)
curl --fail --location --retry 3 --retry-all-errors \
  --output "$INSTALLER" \
  https://mise.run

mkdir -p "$(dirname "$INSTALL_PATH")"
MISE_INSTALL_PATH="$INSTALL_PATH" sh "$INSTALLER"
echo "Installed $("$INSTALL_PATH" --version) to $INSTALL_PATH"
