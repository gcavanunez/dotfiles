#!/usr/bin/env bash
set -euo pipefail

readonly REX_BIN="/usr/bin/rex"
readonly CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/rex/upgrade.conf"

if [[ $# == 1 && "$1" == --help ]]; then
  echo "Usage: ${0##*/}"
  echo 'Run locally on Omarchy, outside Rex: update packages, then restart the personal Rex server.'
  exit 0
fi
if [[ $# != 0 ]]; then
  echo "Usage: ${0##*/}" >&2
  exit 2
fi
if [[ $(uname -s) != Linux ]]; then
  echo 'Error: this Rex updater is for Omarchy Linux.' >&2
  exit 1
fi
if [[ -n ${REX_SESSION:-} ]]; then
  echo 'Error: run this from SSH or a terminal outside Rex; restarting Rex ends its programs.' >&2
  exit 1
fi
command -v omarchy >/dev/null 2>&1 && [[ -x "$REX_BIN" ]] || {
  echo 'Error: Omarchy and the packaged Rex CLI are required.' >&2
  exit 1
}
[[ -f "$CONFIG_PATH" ]] || {
  echo "Error: first put this server's REX_START_ARGS array in $CONFIG_PATH (outside dotfiles)." >&2
  exit 1
}

# Keep hostnames, Tailscale options, and other local flags out of public dotfiles.
REX_START_ARGS=()
source "$CONFIG_PATH"
unset REX_SERVER REX_CLIENT REX_SESSION REX_BLOCK

echo 'Updating system packages. On success, Rex will restart and its running programs will end.'
omarchy update
"$REX_BIN" --autostart=false server stop
if (( ${#REX_START_ARGS[@]} )); then
  "$REX_BIN" server start "${REX_START_ARGS[@]}"
else
  "$REX_BIN" server start
fi
"$REX_BIN" server status
