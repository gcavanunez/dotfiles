#!/usr/bin/env bash
set -euo pipefail

readonly REX_BIN="/usr/bin/rex"
readonly SERVICE="rex.service"

if [[ $# == 1 && "$1" == --help ]]; then
  echo "Usage: ${0##*/}"
  echo 'Restart the local Rex systemd user service using the already installed package.'
  exit 0
fi
if [[ $# != 0 ]]; then
  echo "Usage: ${0##*/}" >&2
  exit 2
fi
if [[ $(uname -s) != Linux ]]; then
  echo 'Error: this Rex restart script is for Linux.' >&2
  exit 1
fi
if [[ -n ${REX_SESSION:-} ]]; then
  echo 'Error: run this from SSH or a terminal outside Rex; restarting Rex ends its programs.' >&2
  exit 1
fi
command -v systemctl >/dev/null 2>&1 && [[ -x "$REX_BIN" ]] || {
  echo 'Error: systemd and the packaged Rex CLI are required.' >&2
  exit 1
}
if ! systemctl --user is-enabled --quiet "$SERVICE" &&
   ! systemctl --user is-active --quiet "$SERVICE"; then
  echo 'Error: configure the packaged Rex user service before using this restart script.' >&2
  exit 1
fi

unset REX_SERVER REX_CLIENT REX_SESSION REX_BLOCK
echo 'Restarting Rex. Programs running in its sessions will end.'
systemctl --user daemon-reload
systemctl --user restart "$SERVICE"
"$REX_BIN" --autostart=false server status
