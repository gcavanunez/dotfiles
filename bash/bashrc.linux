[[ $- != *i* ]] && return

[ -f ~/.config/bash/pre.bash ] && source ~/.config/bash/pre.bash

# opencode
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"

# GPG signing is opt-in. Uncomment when using GPG-signed commits.
# export GPG_TTY=$(tty)

[ -f ~/.config/bash/init.bash ] && source ~/.config/bash/init.bash
