#!/usr/bin/env bash

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
OS=$(uname -s)

# Ensure mise-installed tools are on PATH
if [ -d "$HOME/.local/share/mise/shims" ]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

if [[ "$OS" == "Darwin" ]]; then
  if command -v brew &>/dev/null; then
    eval "$(brew shellenv)"
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

tool_version() {
  local bin="$1"

  case "$bin" in
    go)
      go version 2>&1
      ;;
    nvim)
      nvim --version 2>&1 | head -1
      ;;
    tmux)
      tmux -V 2>&1
      ;;
    *)
      "$bin" --version 2>&1 | head -1
      ;;
  esac
}

check_shell_rc() {
  local shell_name="$1"
  local extension="$2"
  local rc_file="$HOME/.${shell_name}rc"
  local rc_name=".${shell_name}rc"
  local template="$DOTFILES/$shell_name/${shell_name}rc.$TEMPLATE_OS"
  local template_reference="$shell_name/${shell_name}rc.$TEMPLATE_OS"
  local missing_setup=""

  if [[ ! -f "$rc_file" ]]; then
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found; bootstrap will create it${NC}\n" "$rc_name"
    return
  fi

  if [[ "$shell_name" == "bash" ]] && grep -Fq '.config/bash/init.bash' "$rc_file"; then
    if grep -Fq '.config/bash/pre.bash' "$rc_file"; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "uses shared Bash initialization"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "$rc_name" "missing early ble.sh initialization"
    fi
    return
  fi

  if [[ "$rc_file" -ef "$template" ]] || grep -Fq "$template_reference" "$rc_file"; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "uses the dotfiles template"
    return
  fi

  if ! grep -Fq '.opencode/bin' "$rc_file"; then
    missing_setup="OpenCode PATH"
  fi
  if ! grep -Fq "mise activate $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }mise"
  fi
  if ! grep -Fq "starship init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }starship"
  fi
  if ! grep -Fq "zoxide init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }zoxide"
  fi
  if ! grep -Fq "fzf --$shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }fzf"
  fi
  if ! grep -Fq "atuin init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }atuin"
  fi
  if ! grep -Fq ".config/$shell_name/functions.$extension" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }shared functions"
  fi
  if ! grep -Fq ".config/$shell_name/aliases.$extension" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }shared aliases"
  fi

  if [[ -z "$missing_setup" ]]; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "contains the dotfiles setup"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}review recommended${NC}\n" "$rc_name"
    echo "    Missing template setup: $missing_setup"
    echo "    Compare with: diff -u \"$rc_file\" \"$template\""
  fi
}

TOOLS=(
  atuin
  bat
  btop
  bun
  cloc
  cloudflared
  delta
  eza
  fd
  fzf
  gh
  go
  jq
  lazydocker
  lazygit
  node
  pi
  ripgrep:rg
  ruby
  rust:rustc
  starship
  tmux
  tree-sitter
  zoxide
)

if [[ "$OS" != "Darwin" ]]; then
  TOOLS+=(mermaid-cli:mmdc php tectonic)
else
  TOOLS+=(ffmpeg gnu-sed:gsed tree)
fi

missing=0

echo "Checking required tools..."
echo ""

for entry in "${TOOLS[@]}"; do
  name="${entry%%:*}"
  bin="${entry##*:}"

  if command -v "$bin" &>/dev/null; then
    version=$(tool_version "$bin")
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$name" "$version"
  else
    printf "  ${RED}✗${NC} %-14s ${RED}not found${NC}\n" "$name"
    missing=$((missing + 1))
  fi
done

echo ""

if [ $missing -eq 0 ]; then
  echo -e "${GREEN}All tools installed.${NC}"
else
  echo -e "${YELLOW}${missing} tool(s) missing.${NC} Install missing tools:"
  echo ""
  if [[ "$OS" == "Darwin" ]]; then
    echo "  brew bundle --file=\"$DOTFILES/Brewfile\""
    echo "  mise install"
  else
    echo "  mise install"
  fi
fi

# --- System-wide tools (not managed by mise) ---

SYSTEM_TOOLS=(
  git
  mise
  nvim
  docker
)

if [[ "$OS" != "Darwin" ]]; then
  SYSTEM_TOOLS+=(ffmpeg sed tree)
fi

sys_missing=0

echo ""
echo "Checking system-wide tools..."
echo ""

for bin in "${SYSTEM_TOOLS[@]}"; do
  if command -v "$bin" &>/dev/null; then
    version=$(tool_version "$bin")
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$bin" "$version"
  else
    printf "  ${RED}✗${NC} %-14s ${RED}not found${NC}\n" "$bin"
    sys_missing=$((sys_missing + 1))
  fi
done

if command -v nvim &>/dev/null; then
  nvim_path=$(realpath "$(command -v nvim)")
  if [[ "$nvim_path" == /opt/neovim/bin/nvim ]]; then
    if [[ -L /usr/local/bin/nvim && $(realpath /usr/local/bin/nvim) == "$nvim_path" ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "nvim install" "dotfiles-managed via /usr/local/bin/nvim"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "nvim install" "expected /usr/local/bin/nvim -> /opt/neovim/bin/nvim"
    fi
  elif [[ "$nvim_path" == /opt/nvim-linux-*/bin/nvim ||
    "$nvim_path" == "${XDG_DATA_HOME:-$HOME/.local/share}"/nvim-linux-*/bin/nvim ]]; then
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "nvim install" "legacy dotfiles path at $nvim_path; run scripts/upgrade-nvim"
  else
    printf "  ${GREEN}✓${NC} %-14s %s\n" "nvim install" "managed externally at $nvim_path"
  fi
fi

if [[ "$OS" == "Linux" ]]; then
  mise_config="$HOME/.config/mise/config.toml"
  mise_target="$DOTFILES/mise/config.linux.toml"
  if [[ -L "$mise_config" && $(realpath "$mise_config") == "$mise_target" ]]; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "mise config" "linked to mise/config.linux.toml"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise config" "not linked to $mise_target"
  fi
fi

# Extra: check if docker daemon is reachable
if command -v docker &>/dev/null; then
  if docker info &>/dev/null 2>&1; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "docker daemon" "running"
  else
    if [[ "$OS" == "Darwin" ]]; then
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}installed but daemon not reachable (start Docker Desktop, OrbStack, or Colima)${NC}\n" "docker daemon"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}installed but daemon not reachable (try: sudo systemctl start docker)${NC}\n" "docker daemon"
    fi
  fi
fi

echo ""

if [ $sys_missing -eq 0 ]; then
  echo -e "${GREEN}All system tools available.${NC}"
else
  echo -e "${YELLOW}${sys_missing} system tool(s) missing.${NC} Install via your package manager:"
  echo ""
  if [[ "$OS" == "Darwin" ]]; then
    echo "  brew bundle --file=\"$DOTFILES/Brewfile\""
    echo "  # Docker: install Docker Desktop, OrbStack, or Colima"
  else
    echo "  # ffmpeg: install via your distro package manager"
    echo "  # sed: install via your distro package manager"
    echo "  # tree: install via your distro package manager"
    echo "  # Docker: https://docs.docker.com/engine/install/"
  fi
fi

# --- Shell configuration ---

echo ""
echo "Checking shell configuration..."
echo ""

if [[ "$OS" == "Darwin" ]]; then
  TEMPLATE_OS="macos"
elif [[ "$OS" == "Linux" ]]; then
  TEMPLATE_OS="linux"
else
  TEMPLATE_OS=""
fi

if [[ -n "$TEMPLATE_OS" ]]; then
  check_shell_rc bash bash
  check_shell_rc zsh zsh
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}no templates for %s${NC}\n" "shell rc" "$OS"
fi

if [[ $(basename "${SHELL:-}") == "bash" ]]; then
  blesh_path="${XDG_DATA_HOME:-$HOME/.local/share}/blesh/ble.sh"
  if [[ -f "$blesh_path" ]]; then
    blesh_version=$(bash "$blesh_path" --version 2>&1)
    printf "  ${GREEN}✓${NC} %-14s %s\n" "ble.sh" "$blesh_version"
  else
    printf "  ${RED}✗${NC} %-14s ${RED}%s${NC}\n" "ble.sh" "not found; run scripts/install-blesh"
  fi
fi

# --- Optional direct-installer tools ---

echo ""
echo "Checking direct-installer tools..."
echo ""

if command -v opencode &>/dev/null; then
  version=$(tool_version opencode)
  printf "  ${GREEN}✓${NC} %-14s %s\n" "opencode" "$version"
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found (install with: curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path)${NC}\n" "opencode"
fi

# --- Ghostty terminfo ---

echo ""
echo "Checking Ghostty terminfo..."
echo ""

if infocmp -x xterm-ghostty &>/dev/null 2>&1; then
  printf "  ${GREEN}✓${NC} %-14s %s\n" "xterm-ghostty" "terminfo installed"
  echo ""
  echo -e "  ${YELLOW}Tip:${NC} Propagate to remote servers with:"
  echo "       infocmp -x xterm-ghostty | ssh YOUR-SERVER -- tic -x -"
else
  printf "  ${RED}✗${NC} %-14s ${RED}terminfo not found${NC}\n" "xterm-ghostty"
  echo ""
  echo -e "  ${YELLOW}Install from Ghostty or manually:${NC}"
  echo "       infocmp -x xterm-ghostty  # verify locally first"
fi

exit $((missing + sys_missing))
