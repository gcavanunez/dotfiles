#!/usr/bin/env bash

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
OS=$(uname -s)
distro_id=""
if [[ "$OS" == "Linux" && -r /etc/os-release ]]; then
  source /etc/os-release
  distro_id="${ID:-}"
fi

# Ensure mise-installed tools are on PATH
if [ -d "$HOME/.local/share/mise/shims" ]; then
  export PATH="$HOME/.local/share/mise/shims:$PATH"
fi

if [[ "$OS" == "Darwin" ]]; then
  if command -v brew &>/dev/null; then
    eval "$(brew shellenv)"
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

tool_version() {
  local bin="$1"

  case "$bin" in
    go)
      go version 2>&1
      ;;
    nvim)
      nvim --version 2>&1 | head -1
      ;;
    tmux)
      tmux -V 2>&1
      ;;
    *)
      "$bin" --version 2>&1 | head -1
      ;;
  esac
}

check_shell_rc() {
  local shell_name="$1"
  local extension="$2"
  local rc_file="$HOME/.${shell_name}rc"
  local rc_name=".${shell_name}rc"
  local template="$DOTFILES/$shell_name/${shell_name}rc.$TEMPLATE_OS"
  local template_reference="$shell_name/${shell_name}rc.$TEMPLATE_OS"
  local missing_setup=""

  if [[ ! -f "$rc_file" ]]; then
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found; bootstrap will create it${NC}\n" "$rc_name"
    return
  fi

  if [[ "$shell_name" == "bash" ]] && grep -Fq '.config/bash/init.bash' "$rc_file"; then
    if grep -Fq '.config/bash/pre.bash' "$rc_file"; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "uses shared Bash initialization"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "$rc_name" "missing early Bash initialization"
    fi
    return
  fi

  if [[ "$rc_file" -ef "$template" ]] || grep -Fq "$template_reference" "$rc_file"; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "uses the dotfiles template"
    return
  fi

  if ! grep -Fq '.opencode/bin' "$rc_file"; then
    missing_setup="OpenCode PATH"
  fi
  if ! grep -Fq "mise activate $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }mise"
  fi
  if ! grep -Fq "starship init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }starship"
  fi
  if ! grep -Fq "zoxide init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }zoxide"
  fi
  if ! grep -Fq "fzf --$shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }fzf"
  fi
  if ! grep -Fq "atuin init $shell_name" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }atuin"
  fi
  if ! grep -Fq ".config/$shell_name/functions.$extension" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }shared functions"
  fi
  if ! grep -Fq ".config/$shell_name/aliases.$extension" "$rc_file"; then
    missing_setup="${missing_setup:+$missing_setup, }shared aliases"
  fi

  if [[ -z "$missing_setup" ]]; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$rc_name" "contains the dotfiles setup"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}review recommended${NC}\n" "$rc_name"
    echo "    Missing template setup: $missing_setup"
    echo "    Compare with: diff -u \"$rc_file\" \"$template\""
  fi
}

TOOLS=(
  atuin
  bat
  btop
  bun
  cloc
  cloudflared
  delta
  eza
  fd
  fzf
  gh
  go
  herdr
  jq
  lazydocker
  lazygit
  node
  pi
  ripgrep:rg
  ruby
  rust:rustc
  starship
  terminal-control:termctrl
  tmux
  tree-sitter
  zoxide
)

if [[ "$OS" != "Darwin" ]]; then
  TOOLS+=(mermaid-cli:mmdc php tectonic)
else
  TOOLS+=(ffmpeg gnu-sed:gsed tree)
fi

missing=0

echo "Checking required tools..."
echo ""

for entry in "${TOOLS[@]}"; do
  name="${entry%%:*}"
  bin="${entry##*:}"

  if command -v "$bin" &>/dev/null; then
    version=$(tool_version "$bin")
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$name" "$version"
  else
    printf "  ${RED}✗${NC} %-14s ${RED}not found${NC}\n" "$name"
    missing=$((missing + 1))
  fi
done

echo ""

if [ $missing -eq 0 ]; then
  echo -e "${GREEN}All tools installed.${NC}"
else
  echo -e "${YELLOW}${missing} tool(s) missing.${NC} Install missing tools:"
  echo ""
  if [[ "$OS" == "Darwin" ]]; then
    echo "  brew bundle --file=\"$DOTFILES/Brewfile\""
    echo "  mise install"
  else
    echo "  mise install"
  fi
fi

# --- System-wide tools (not managed by mise) ---

SYSTEM_TOOLS=(
  git
  mise
  nvim
  docker
)

if [[ "$OS" != "Darwin" ]]; then
  SYSTEM_TOOLS+=(ffmpeg sed tree)
fi

sys_missing=0

echo ""
echo "Checking system-wide tools..."
echo ""

for bin in "${SYSTEM_TOOLS[@]}"; do
  if command -v "$bin" &>/dev/null; then
    version=$(tool_version "$bin")
    printf "  ${GREEN}✓${NC} %-14s %s\n" "$bin" "$version"
  else
    printf "  ${RED}✗${NC} %-14s ${RED}not found${NC}\n" "$bin"
    sys_missing=$((sys_missing + 1))
  fi
done

if command -v mise &>/dev/null; then
  mise_path=$(realpath "$(command -v mise)")
  if [[ "$distro_id" == "omarchy" ]]; then
    if [[ "$mise_path" == /usr/bin/mise ]] && pacman -Qq mise-bin &>/dev/null; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "mise install" "Omarchy-managed mise-bin at /usr/bin/mise"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise install" "expected Omarchy's mise-bin; found $mise_path"
    fi

    if [[ $(mise settings get auto_update 2>/dev/null) == false ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "mise updates" "binary managed by omarchy update"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise updates" "disable binary self-update for Omarchy's mise-bin"
    fi
  else
    expected_mise_path="$HOME/.local/bin/mise"
    if [[ "$mise_path" == "$expected_mise_path" ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "mise install" "official standalone at $expected_mise_path"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise install" "expected $expected_mise_path; found $mise_path"
    fi

    if [[ $(mise settings get auto_update 2>/dev/null) == true ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "mise updates" "automatic self-update enabled"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise updates" "automatic self-update not enabled"
    fi
  fi
fi

if command -v nvim &>/dev/null; then
  nvim_path=$(realpath "$(command -v nvim)")
  if [[ "$nvim_path" == /opt/neovim/bin/nvim ]]; then
    if [[ -L /usr/local/bin/nvim && $(realpath /usr/local/bin/nvim) == "$nvim_path" ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "nvim install" "dotfiles-managed via /usr/local/bin/nvim"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "nvim install" "expected /usr/local/bin/nvim -> /opt/neovim/bin/nvim"
    fi
  elif [[ "$nvim_path" == /opt/nvim-linux-*/bin/nvim ||
    "$nvim_path" == "${XDG_DATA_HOME:-$HOME/.local/share}"/nvim-linux-*/bin/nvim ]]; then
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "nvim install" "legacy dotfiles path at $nvim_path; run scripts/upgrade-nvim"
  else
    printf "  ${GREEN}✓${NC} %-14s %s\n" "nvim install" "managed externally at $nvim_path"
  fi
fi

if [[ "$OS" == "Darwin" ]]; then
  mise_target="$DOTFILES/mise/config.macos.toml"
elif [[ "$OS" == "Linux" ]]; then
  if [[ "$distro_id" == "omarchy" ]]; then
    mise_target="$DOTFILES/mise/config.omarchy.toml"
  else
    mise_target="$DOTFILES/mise/config.linux.toml"
  fi
fi

if [[ -n "${mise_target:-}" ]]; then
  mise_config="$HOME/.config/mise/config.toml"
  if [[ -L "$mise_config" && $(realpath "$mise_config") == "$mise_target" ]]; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "mise config" "linked to mise/$(basename "$mise_target")"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise config" "not linked to $mise_target"
  fi
fi

# Extra: check if docker daemon is reachable
if command -v docker &>/dev/null; then
  if docker info &>/dev/null 2>&1; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "docker daemon" "running"
  else
    if [[ "$OS" == "Darwin" ]]; then
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}installed but daemon not reachable (start Docker Desktop, OrbStack, or Colima)${NC}\n" "docker daemon"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}installed but daemon not reachable (try: sudo systemctl start docker)${NC}\n" "docker daemon"
    fi
  fi
fi

echo ""

if [ $sys_missing -eq 0 ]; then
  echo -e "${GREEN}All system tools available.${NC}"
else
  echo -e "${YELLOW}${sys_missing} system tool(s) missing.${NC} Install via your package manager:"
  echo ""
  if [[ "$OS" == "Darwin" ]]; then
    echo "  brew bundle --file=\"$DOTFILES/Brewfile\""
    echo "  # Docker: install Docker Desktop, OrbStack, or Colima"
  else
    echo "  # ffmpeg: install via your distro package manager"
    echo "  # sed: install via your distro package manager"
    echo "  # tree: install via your distro package manager"
    echo "  # Docker: https://docs.docker.com/engine/install/"
  fi
fi

# --- Shell configuration ---

echo ""
echo "Checking shell configuration..."
echo ""

if [[ "$OS" == "Darwin" ]]; then
  TEMPLATE_OS="macos"
elif [[ "$OS" == "Linux" ]]; then
  TEMPLATE_OS="linux"
else
  TEMPLATE_OS=""
fi

if [[ -n "$TEMPLATE_OS" ]]; then
  check_shell_rc bash bash
  check_shell_rc zsh zsh
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}no templates for %s${NC}\n" "shell rc" "$OS"
fi

# --- Optional direct-installer tools ---

echo ""
echo "Checking direct-installer tools..."
echo ""

if command -v opencode &>/dev/null; then
  version=$(tool_version opencode)
  printf "  ${GREEN}✓${NC} %-14s %s\n" "opencode" "$version"
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found (install with: curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path)${NC}\n" "opencode"
fi

claude_launcher="$HOME/.local/bin/claude"
claude_versions="$HOME/.local/share/claude/versions"
if [[ "${distro_id:-}" == "omarchy" ]]; then
  if command -v claude &>/dev/null; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "claude" "managed by Omarchy at $(command -v claude)"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found (install with: omarchy-mise-install claude)${NC}\n" "claude"
  fi
elif [[ -L "$claude_launcher" && $(readlink "$claude_launcher") == "$claude_versions"/* ]]; then
  printf "  ${GREEN}✓${NC} %-14s %s\n" "claude" "native $(basename "$(readlink "$claude_launcher")")"
  if [[ -n "${DISABLE_AUTOUPDATER:-}${DISABLE_UPDATES:-}" ]]; then
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "claude updates" "disabled by DISABLE_AUTOUPDATER/DISABLE_UPDATES"
  fi
elif command -v claude &>/dev/null; then
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "claude" "found at $(command -v claude); expected native launcher at $claude_launcher"
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}not found (install with: curl -fsSL https://claude.ai/install.sh | bash)${NC}\n" "claude"
fi

# --- Agent integrations ---

echo ""
echo "Checking agent integrations..."
echo ""

if command -v herdr &>/dev/null; then
  herdr_integrations=$(herdr integration status 2>/dev/null)
  for agent in pi opencode; do
    status_line=$(grep "^$agent:" <<< "$herdr_integrations")
    if [[ "$status_line" == "$agent: current "* ]]; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "herdr/$agent" "${status_line#"$agent: "}"
    elif [[ -n "$status_line" ]]; then
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s (run: herdr integration install %s)${NC}\n" "herdr/$agent" "${status_line#"$agent: "}" "$agent"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}status unavailable${NC}\n" "herdr/$agent"
    fi
  done
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}Herdr not installed${NC}\n" "herdr"
fi

# --- Drift guardrails ---

echo ""
echo "Checking for drift..."
echo ""

dirty=$(git -C "$DOTFILES" status --porcelain 2>/dev/null)
if [[ -z "$dirty" ]]; then
  printf "  ${GREEN}✓${NC} %-14s %s\n" "dotfiles repo" "clean on $(git -C "$DOTFILES" rev-parse --abbrev-ref HEAD 2>/dev/null)"
else
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "dotfiles repo" "$(wc -l <<< "$dirty" | tr -d ' ') uncommitted change(s); commit shared work or drop it"
fi

mise_bins=$(type -ap mise 2>/dev/null | while read -r bin; do realpath "$bin"; done | sort -u)
if [[ $(grep -c . <<< "$mise_bins") -gt 1 ]]; then
  printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "mise binaries" "more than one on PATH: $(tr '\n' ' ' <<< "$mise_bins")"
fi

if [[ "$OS" == "Linux" ]] && systemctl --user is-enabled opencode.service &>/dev/null; then
  if [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) == yes ]]; then
    printf "  ${GREEN}✓${NC} %-14s %s\n" "linger" "user services start at boot"
  else
    printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "linger" "off; run: sudo loginctl enable-linger $USER"
  fi
fi

if [[ $(git config --global commit.gpgsign) == true ]]; then
  if [[ $(git config --global gpg.format) == ssh ]]; then
    signing_key=$(git config --global user.signingkey)
    signing_key="${signing_key/#\~/$HOME}"
    if [[ -f "${signing_key%.pub}" ]] && ssh-keygen -y -P "" -f "${signing_key%.pub}" &>/dev/null; then
      printf "  ${GREEN}✓${NC} %-14s %s\n" "signing" "SSH key signs without a prompt"
    else
      printf "  ${YELLOW}!${NC} %-14s ${YELLOW}%s${NC}\n" "signing" "SSH signing key missing or passphrase-protected (see setup/ssh-signing.sh)"
    fi
  else
    printf "  ${GREEN}✓${NC} %-14s %s\n" "signing" "GPG signing enabled"
  fi
fi

# --- Ghostty terminfo ---

echo ""
echo "Checking Ghostty terminfo..."
echo ""

if infocmp -x xterm-ghostty &>/dev/null 2>&1; then
  printf "  ${GREEN}✓${NC} %-14s %s\n" "xterm-ghostty" "terminfo installed"
  echo ""
  echo -e "  ${YELLOW}Tip:${NC} Propagate to remote servers with:"
  echo "       infocmp -x xterm-ghostty | ssh YOUR-SERVER -- tic -x -"
else
  printf "  ${RED}✗${NC} %-14s ${RED}terminfo not found${NC}\n" "xterm-ghostty"
  echo ""
  echo -e "  ${YELLOW}Install from Ghostty or manually:${NC}"
  echo "       infocmp -x xterm-ghostty  # verify locally first"
fi

exit $((missing + sys_missing))
