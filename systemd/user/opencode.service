[Unit]
Description=OpenCode server
Documentation=https://opencode.ai/v2/docs/server/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment="PATH=%h/.opencode/bin:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DOCKER_HOST=unix:///var/run/docker.sock"
Environment="PLANNOTATOR_REMOTE=1"
Environment="PLANNOTATOR_PORT=19432-19463"
EnvironmentFile=%h/.config/opencode/server.env
ExecStartPre=-%h/.opencode/bin/opencode service stop
ExecStart=%h/.local/bin/opencode-systemd-serve --port 4096 --hostname 0.0.0.0
ExecStartPost=%h/.local/bin/opencode-systemd-serve --wait-ready
ExecStopPost=-/usr/bin/rm -f %h/.local/state/opencode/service.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
